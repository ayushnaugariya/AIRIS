# AIRIS frontend environment configuration
# Copy to .env.local and adjust when connecting the real FastAPI backend.

# REST base URL of the FastAPI service. Leave EMPTY to run in mock mode
# (all API modules serve deterministic mock data from src/lib/mock).
NEXT_PUBLIC_API_BASE_URL=

# WebSocket endpoint for the live feed (anomaly stream, index ticks).
# Leave EMPTY to use the built-in mock live feed (src/lib/ws/live-feed.ts).
NEXT_PUBLIC_WS_URL=
